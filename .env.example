NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://localhost:27017/luvio_collaboration
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
APP_WEB_URL=http://localhost:3000,http://127.0.0.1:3000,null

# Configure all three values together in staging/production. When omitted in
# development, Huddles run in explicit UI-only media mode.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HUDDLE_TOKEN_TTL_SECONDS=600
HUDDLE_PARTICIPANT_TTL_SECONDS=120
HUDDLE_EMPTY_GRACE_SECONDS=30
